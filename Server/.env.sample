# Server runtime
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Role guard for Manager/Admin registration
REGISTRATION_KEY=replace_with_manager_admin_registration_key

# OTP email (Gmail app password or SMTP credentials used by mailer)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
